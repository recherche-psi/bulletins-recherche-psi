{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "recherche-psi-assistant",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-27",
  "workers_dev": true,
  "observability": {"enabled": false},
  "durable_objects": {"bindings": [{"name": "BUDGET", "class_name": "AssistantBudget"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["AssistantBudget"]}],
  "vars": {
    "ALLOWED_ORIGIN": "https://recherche-psi.github.io",
    "AI_ENABLED": "false",
    "LEGAL_REVIEW_CONFIRMED": "false",
    "PRICING_REVIEW_CONFIRMED": "false",
    "APPROVED_MONTH": "",
    "MODEL": "",
    "MODEL_INPUT_TOKEN_CEILING": "",
    "INPUT_USD_PER_MILLION": "",
    "OUTPUT_USD_PER_MILLION": ""
  }
}
