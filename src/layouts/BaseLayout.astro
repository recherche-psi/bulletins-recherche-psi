---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  lang?: 'fr' | 'en';
  alternatePath?: string | null;
}
const { lang = 'fr', alternatePath } = Astro.props;
const en = lang === 'en';
const brand = en ? 'Psi Research Bulletins' : 'Bulletins de la recherche psi';
const {
  title = brand,
  description = en ? 'Critical reviews of publications in parapsychology, anomalistics and consciousness studies.' : 'Analyses critiques de publications en parapsychologie, anomalistique et sciences de la conscience.',
} = Astro.props;
const pageTitle = title === brand ? title : `${title} | ${brand}`;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
const base = import.meta.env.BASE_URL;
const home = `${base}${en ? 'en/' : ''}`;
const pairs: Record<string, string> = {
  '': 'en/', 'bulletins/': 'en/bulletins/', 'methode/': 'en/method/', 'a-propos/': 'en/about/',
  'en/': '', 'en/bulletins/': 'bulletins/', 'en/method/': 'methode/', 'en/about/': 'a-propos/',
};
const relativePath = Astro.url.pathname.slice(base.length);
const other = alternatePath !== undefined ? alternatePath : pairs[relativePath];
const alternate = other != null ? new URL(`${base}${other}`, canonical) : null;
const otherLang = en ? 'fr' : 'en';
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternate && <><link rel="alternate" hreflang={lang} href={canonical} /><link rel="alternate" hreflang={otherLang} href={alternate} /></>}
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="alternate" type="application/rss+xml" title={brand} href={`${home}rss.xml`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={en ? 'en_GB' : 'fr_FR'} />
    {alternate && <meta property="og:locale:alternate" content={en ? 'fr_FR' : 'en_GB'} />}
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">{en ? 'Skip to content' : 'Aller au contenu'}</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={home} aria-label={en ? 'Home' : 'Accueil'}>
          <span class="brand-mark" aria-hidden="true">Ψ</span>
          <span><strong>{en ? 'Psi Research' : 'Bulletins'}</strong><small>{en ? 'Bulletins' : 'de la recherche psi'}</small></span>
        </a>
        <div class="header-navigation">
          <nav aria-label={en ? 'Main navigation' : 'Navigation principale'}>
            <a href={`${home}bulletins/`}>Bulletins</a>
            <a href={`${home}${en ? 'method' : 'methode'}/`}>{en ? 'Method' : 'Méthode'}</a>
            <a href={`${home}${en ? 'about' : 'a-propos'}/`}>{en ? 'About' : 'À propos'}</a>
            <a href={`${home}rss.xml`}>RSS</a>
          </nav>
          <nav class="language-switch" aria-label={en ? 'Language' : 'Langue'}>
            {(['fr', 'en'] as const).map((code) => code === lang ? (
              <span lang={code} aria-current="page">{code.toUpperCase()}</span>
            ) : alternate ? (
              <a href={alternate.pathname} lang={code} hreflang={code} aria-label={code === 'en' ? 'Read this page in English' : 'Lire cette page en français'}>{code.toUpperCase()}</a>
            ) : (
              <span lang={code} aria-disabled="true" title={en ? 'French translation not yet available' : 'Traduction anglaise pas encore disponible'}>{code.toUpperCase()}</span>
            ))}
          </nav>
        </div>
      </div>
    </header>
    <main id="contenu"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-inner">
        <p><strong>{brand}</strong><br />{en ? 'Critical, documented and independent research monitoring.' : 'Une veille critique, documentée et indépendante.'}</p>
        <p>{en ? 'Text licensed under' : 'Textes sous licence'} <a href={`https://creativecommons.org/licenses/by/4.0/${en ? 'deed.en' : 'deed.fr'}`}>CC BY 4.0</a>.<br />{en ? 'Source code licensed under MIT.' : 'Code source sous licence MIT.'}</p>
      </div>
      <nav class="shell social-follow" aria-labelledby="social-heading">
        <h2 id="social-heading">{en ? 'Follow the bulletin' : 'Suivre le bulletin'}</h2>
        <ul>
          <li><a href="https://www.instagram.com/recherche_psi/" rel="me">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" focusable="false"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" /></svg>
            <span>Instagram</span>
          </a></li>
          <li><a href="https://www.facebook.com/profile.php?id=61594624885121" rel="me">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M14 22v-9h3l.5-4H14V6.5c0-1.1.3-1.5 1.7-1.5H18V1.4A29 29 0 0 0 14.7 1C11.4 1 9 3 9 6.5V9H6v4h3v9z" /></svg>
            <span>Facebook</span>
          </a></li>
          <li><a href="https://mastodon.social/@recherche_psi" rel="me">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M21.6 6.6c-.3-2.4-2.4-4.3-5-4.7a29 29 0 0 0-9.2 0c-2.6.4-4.7 2.3-5 4.7-.4 3.2-.2 7.2.4 10.2.8 3.6 4.1 5 7.5 5.2 2 .1 3.8-.3 4.8-.7l-.1-2.2c-1.2.4-2.6.6-4.1.5-2.2-.1-3.4-.9-3.6-2.7 2 .5 4.4.7 6.5.6 4.1-.2 7.4-1.2 7.8-5.1.2-1.8.2-4 0-5.8ZM18 13.8h-2.3V8.3c0-2-2.5-2-2.5.4v3h-2.4v-3c0-2.4-2.5-2.4-2.5-.4v5.5H6V8.2c0-4.3 4.2-4.5 6-1.9 1.8-2.6 6-2.4 6 1.9z" /></svg>
            <span>Mastodon</span>
          </a></li>
          <li><a href="https://bsky.app/profile/recherche-psi.bsky.social" rel="me">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M5.2 3.3C8 5.4 11 9.5 12 11.7c1-2.2 4-6.3 6.8-8.4C20.8 1.8 24 .6 24 4.3c0 .7-.4 5.7-.6 6.5-.8 2.8-3.6 3.5-6.2 3.1 4.5.8 5.7 3.5 3.2 6.2-4.7 4.9-6.8-1.2-7.4-2.8-.1-.3-.2-.5-.2-.3 0-.2-.1 0-.2.3-.6 1.6-2.7 7.7-7.4 2.8-2.5-2.7-1.3-5.4 3.2-6.2-2.6.4-5.4-.3-6.2-3.1C2 10 1.6 5 1.6 4.3 1.6.6 3.2 1.8 5.2 3.3Z" transform="translate(-.8 0)" /></svg>
            <span>Bluesky</span>
          </a></li>
        </ul>
      </nav>
    </footer>
  </body>
</html>

<style>
  .social-follow {
    display: block;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid rgb(245 241 232 / 25%);
  }
  .social-follow h2 {
    margin: 0 0 .85rem;
    font-family: inherit;
    font-size: .9rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.5;
  }
  .social-follow ul {
    display: flex;
    flex-wrap: wrap;
    gap: .65rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .social-follow a {
    display: inline-flex;
    align-items: center;
    gap: .6rem;
    min-height: 44px;
    padding: .5rem .85rem;
    border: 1px solid rgb(245 241 232 / 35%);
    border-radius: 4px;
    color: var(--paper);
    text-decoration: none;
  }
  .social-follow a:hover {
    background: var(--paper);
    color: var(--ink);
  }
  .social-follow a:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 4px;
  }
  .social-follow svg { width: 20px; height: 20px; flex-shrink: 0; }
  @media print { .social-follow { display: none; } }
</style>
