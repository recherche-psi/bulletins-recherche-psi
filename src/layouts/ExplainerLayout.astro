---
import BaseLayout from './BaseLayout.astro';
const { post, previous, next, lang = 'fr', alternatePath } = Astro.props;
const en = lang === 'en';
const section = `${import.meta.env.BASE_URL}${en ? 'en/explainers' : 'vulgarisation'}/`;
const date = new Intl.DateTimeFormat(en ? 'en-GB' : 'fr-FR', { day: 'numeric', month: 'long', year: 'numeric' }).format(post.data.publishedAt);
---
<BaseLayout title={post.data.title} description={post.data.description} lang={lang} alternatePath={alternatePath}>
  <article class="article shell-narrow">
    <header class="article-header">
      <a class="text-link" href={`${section}`}>{en ? '← All explainers' : '← Tous les articles de vulgarisation'}</a>
      <p class="eyebrow">{en ? 'Explainer' : 'Vulgarisation'} · {post.data.reading} {en ? 'read' : 'de lecture'}</p>
      <h1>{post.data.title}</h1>
      <p class="publication-date">{en ? 'Published on' : 'Publié le'} <time datetime={post.data.publishedAt.toISOString().slice(0, 10)}>{date}</time></p>
    </header>
    <div class="prose"><slot /></div>
    <nav class="article-navigation" aria-label={en ? 'Keep reading' : 'Poursuivre la lecture'}>
      {previous && <a href={`${section}${previous.id}/`} rel="prev"><span>{en ? '← Previous article' : '← Article précédent'}</span>{previous.data.title}</a>}
      {next && <a href={`${section}${next.id}/`} rel="next"><span>{en ? 'Next article →' : 'Article suivant →'}</span>{next.data.title}</a>}
    </nav>
  </article>
</BaseLayout>
<style>
  .article-header { padding-top: 3rem; }
  .article-header h1 { font-size: clamp(2.5rem, 5vw, 4rem); }
  .publication-date { color: var(--muted); font-size: .85rem; }
  .article-navigation { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 1px solid var(--line); }
  .article-navigation a { text-align: left; }
  .article-navigation span { display: block; margin-bottom: .5rem; color: var(--teal); font-size: .75rem; }
  @media (max-width: 600px) { .article-navigation { grid-template-columns: 1fr; } }
</style>
