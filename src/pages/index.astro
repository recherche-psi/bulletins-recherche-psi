---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';

const bulletins = (await getCollection('bulletins', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const latest = bulletins[0];
const base = import.meta.env.BASE_URL;
const formatDate = (date: Date) => new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric' })
  .format(date)
  .replace(/^1 /, '1er ');
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Veille scientifique indépendante</p>
        <h1>Lire les résultats.<br /><em>Évaluer les méthodes.</em></h1>
        <p class="hero-copy">Des analyses accessibles et exigeantes de publications en parapsychologie, anomalistique et sciences de la conscience.</p>
        <a class="button" href={`${base}bulletins/`}>Consulter les bulletins</a>
      </div>
      <aside class="principles" aria-label="Principes éditoriaux">
        <span>01</span><p><strong>Sources vérifiées</strong>Références, DOI et documents originaux.</p>
        <span>02</span><p><strong>Lecture critique</strong>Apports, forces, limites et portée réelle.</p>
        <span>03</span><p><strong>Conclusion mesurée</strong>Ni promotion, ni rejet de principe.</p>
      </aside>
    </div>
  </section>

  {latest && (
    <section class="shell latest">
      <p class="section-label">Dernière analyse</p>
      <article class="feature-card">
        <div class="feature-date"><span>{formatDate(latest.data.publishedAt)}</span><small>{latest.data.reading}</small></div>
        <div>
          <h2><a href={`${base}bulletins/${latest.id}/`}>{latest.data.title}</a></h2>
          <p>{latest.data.description}</p>
          <a class="text-link" href={`${base}bulletins/${latest.id}/`}>Lire l'analyse <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>
  )}

  <section class="shell editorial-grid" aria-labelledby="vulgarisation-title">
    <div><p class="section-label">Vulgarisation</p><h2 id="vulgarisation-title">La recherche psi en questions simples</h2></div>
    <div><p>Des articles courts pour découvrir les expériences, comprendre leurs résultats et explorer les rêves, les intuitions et les méthodes scientifiques.</p><a class="text-link" href={`${base}vulgarisation/`}>Découvrir les articles <span aria-hidden="true">→</span></a></div>
  </section>

  <section class="shell editorial-grid">
    <div><p class="section-label">Le projet</p><h2>Une ressource pour suivre ce que les études établissent réellement</h2></div>
    <p>Chaque bulletin distingue les résultats, leur interprétation et les questions qui demeurent ouvertes. Les articles évalués par les pairs, prépublications, rapports et jeux de données sont clairement identifiés.</p>
  </section>
</BaseLayout>
