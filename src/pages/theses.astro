---
import BaseLayout from '../layouts/BaseLayout.astro';
import directory from '../data/theses.html?raw';
import '../styles/theses.css';
---

<BaseLayout
  title="Thèses sur le psi et les expériences exceptionnelles"
  description="109 thèses en France et à l’étranger, classées par thème : descriptions, résultats, sources et liens vers les travaux universitaires."
  alternatePath={null}
>
  <article class="article shell-narrow theses-page">
    <header class="page-head">
      <p class="eyebrow">Ressources · Thèses</p>
      <h1 id="thèses-sur-le-psi-et-les-expériences-exceptionnelles">Thèses sur le psi et les expériences exceptionnelles</h1>
      <p>Un répertoire thématique des recherches doctorales en France et à l’étranger.</p>
    </header>
    <div class="prose theses-body" set:html={directory} />
    <p class="theses-back"><a href="#thèses-sur-le-psi-et-les-expériences-exceptionnelles">Revenir en haut de la page ↑</a></p>
  </article>
</BaseLayout>
