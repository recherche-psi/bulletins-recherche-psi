---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const bulletins = (await getCollection('bulletinsEn', ({ data }) => !data.draft))
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
const latest = bulletins[0];
const base = `${import.meta.env.BASE_URL}en/`;
const formatDate = (date: Date) => new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' })
  .format(date);
---

<BaseLayout lang="en">
  <section class="hero">
    <div class="shell hero-grid">
      <div>
        <p class="eyebrow">Independent research monitoring</p>
        <h1>Read the findings.<br /><em>Assess the methods.</em></h1>
        <p class="hero-copy">Accessible, rigorous reviews of publications in parapsychology, anomalistics and consciousness studies.</p>
        <a class="button" href={`${base}bulletins/`}>Browse the bulletins</a>
      </div>
      <aside class="principles" aria-label="Editorial principles">
        <span>01</span><p><strong>Verified sources</strong>References, DOIs and original documents.</p>
        <span>02</span><p><strong>Critical reading</strong>Contributions, strengths, limitations and implications.</p>
        <span>03</span><p><strong>Proportionate conclusions</strong>Neither advocacy nor dismissal on principle.</p>
      </aside>
    </div>
  </section>

  {latest && (
    <section class="shell latest">
      <p class="section-label">Latest bulletin</p>
      <article class="feature-card">
        <div class="feature-date"><span>{formatDate(latest.data.publishedAt)}</span><small>{latest.data.reading}</small></div>
        <div>
          <h2><a href={`${base}bulletins/${latest.id}/`}>{latest.data.title}</a></h2>
          <p>{latest.data.description}</p>
          <a class="text-link" href={`${base}bulletins/${latest.id}/`}>Read the bulletin <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </section>
  )}

  <section class="shell editorial-grid">
    <div><p class="section-label">The project</p><h2>A resource for understanding what studies actually establish</h2></div>
    <p>Each bulletin distinguishes findings, interpretations and open questions. Peer-reviewed articles, preprints, reports and datasets are clearly identified.</p>
  </section>
</BaseLayout>
