---
import { getCollection, render } from 'astro:content';
import BulletinLayout from '../../../layouts/BulletinLayout.astro';

export async function getStaticPaths() {
  const posts = await getCollection('bulletinsEn', ({ data }) => !data.draft);
  const originals = new Set((await getCollection('bulletins', ({ data }) => !data.draft)).map(post => post.id));
  return posts.map(post => {
    if (!originals.has(post.id)) throw new Error(`Missing French bulletin for translation: ${post.id}`);
    return { params: { id: post.id }, props: { post } };
  });
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const editUrl = `https://github.com/recherche-psi/bulletins-recherche-psi/edit/main/src/content/bulletins-en/${post.id}.md`;
---
<BulletinLayout data={post.data} editUrl={editUrl} headings={headings} lang="en" alternatePath={`bulletins/${post.id}/`}><Content /></BulletinLayout>
