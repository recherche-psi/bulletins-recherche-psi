---
import BaseLayout from '../../layouts/BaseLayout.astro';
import data from '../../data/evidence-2026.json';
import EvidenceDirectory from '../../components/EvidenceDirectory.astro';
import '../../styles/evidence.css';
const base = import.meta.env.BASE_URL;
const newTopicsCount = data.topics.filter(t=>t.new).length;
const groups = [
  {name:'Perception', id:'perception', description:'Cibles, rêve, médiumnité, regard et psi animal'},
  {name:'Anticipation', id:'anticipation', description:'Événements futurs et signaux pré-stimulus'},
  {name:'Interaction', id:'interaction', description:'Micro-PK, rétro-PK, systèmes optiques et biologiques'},
];
---
<BaseLayout title="État des preuves en recherche psi" description={`${data.topics.length} dossiers : bilans empiriques, conditions d'obtention et questions ouvertes.`} alternatePath={null}>
<div class="shell evidence">
  <header class="mast">
    <p class="eyebrow">Espace chercheurs · Édition pilote 2026</p>
    <h1>État des preuves<br/><em>en recherche psi</em></h1>
    <p class="intro">{data.topics.length} dossiers pour lire les résultats, leurs conditions et leur portée.</p>
    <p class="meta">Mise à jour : {data.date} · {newTopicsCount} {newTopicsCount===1?'nouveau dossier':'nouveaux dossiers'}</p>
  </header>
  <nav class="jump" aria-label="Sommaire"><a href="#dossiers">Les dossiers</a><a href="#lecture-specifique">Lecture spécifique</a><a href="#clinique">Clinique</a><a href="#transversal">Conditions et modérateurs</a><a href="#grille">Comment lire</a><a href="#edition">Éditions et méthode</a></nav>

  <section id="dossiers" class="directory">
    <div class="section-heading"><h2>En un regard</h2><span class="small">Ouvrir une fiche pour les données et les sources</span></div>
    <p class="small reading-note">Chaque dossier distingue <strong>résultats, robustesse, conditions d'obtention et portée des conclusions</strong>. Les questions proposées sont illustratives. <a href="#grille">Comprendre cette lecture</a>.</p>
    <div class="directory-tools" id="directory-tools" hidden>
      <label for="topic-search">Rechercher un dossier, un thème ou un auteur</label>
      <input id="topic-search" type="search" placeholder="Ex. : hypnose, double fente, psychométrie…" autocomplete="off" aria-controls="topic-directory" />
      <div class="directory-actions"><span id="topic-count" role="status" aria-live="polite">{data.topics.length} dossiers</span><button type="button" id="expand-topics">Tout ouvrir</button><button type="button" id="collapse-topics">Tout replier</button></div>
    </div>
    <div id="topic-directory">
      {groups.map(group => <EvidenceDirectory id={`groupe-${group.id}`} title={group.name} description={group.description} topics={data.topics.filter(t=>t.group===group.name)} open={group.name==='Perception'}/>)}
      <div id="lecture-specifique" class="directory-section" data-directory-section>
        <EvidenceDirectory id="groupe-specifique" title="Dossiers à lecture spécifique" description="Neurosciences, expériences exceptionnelles et données de terrain" topics={data.topics.filter(t=>t.kind==='specific')}/>
      </div>
      <div id="clinique" class="directory-section" data-directory-section>
        <EvidenceDirectory id="groupe-clinique" title="Accompagnements cliniques" description="Détresse, intégration du vécu et résultats des accompagnements" topics={data.topics.filter(t=>t.kind==='clinical')}/>
      </div>
      <div id="transversal" class="directory-section" data-directory-section>
        <EvidenceDirectory id="groupe-transversal" title="Conditions d'obtention et modérateurs" description="Hypnose, méditation, croyances et évolution des effets" topics={data.topics.filter(t=>String(t.group)==='Transversal')}/>
      </div>
    </div>
    <p class="small" id="no-topics" hidden>Aucun dossier ne correspond à cette recherche. Essayer un terme plus court ou un autre nom.</p>
    <p class="small">Les corpus peuvent se recouvrir. Les effets des différentes fiches ne doivent pas être additionnés ni comparés sans tenir compte de leurs échelles.</p>
  </section>

  <section id="grille">
    <h2>Quatre dimensions de lecture</h2>
    <p class="small">La reproductibilité est examinée avec les conditions d'obtention et la variabilité. Elle contribue à la lecture du dossier sans résumer, à elle seule, sa valeur probante. <a href={`${base}etat-des-preuves/conditions-moderateurs/`}>Consulter les études sur les conditions et les modérateurs</a>.</p>
    <details><summary>Les quatre dimensions de chaque fiche</summary>
      <div class="table-scroll"><table class="profile-table"><thead><tr><th scope="col">Dimension</th><th scope="col">Ce qui est examiné</th></tr></thead><tbody>
      <tr><th scope="row">Résultats observés</th><td>Nature des observations, sens et amplitude des effets, incertitude ; résultats positifs comme nuls.</td></tr>
      <tr><th scope="row">Robustesse méthodologique</th><td>Contrôles, qualité documentaire, biais possibles, sensibilité des analyses et indépendance des données.</td></tr>
      <tr><th scope="row">Variabilité et conditions d'obtention</th><td>Différences entre participants, équipes, contextes et protocoles ; stabilité des résultats dans des conditions définies.</td></tr>
      <tr><th scope="row">Portée des conclusions</th><td>Ce que les observations permettent d'affirmer, les explications effectivement examinées et ce qui demeure ouvert.</td></tr>
      </tbody></table></div>
    </details>
    <details><summary>Quelle place pour les réplications ?</summary>
      <p>Un résultat reproduit précise la stabilité d'une observation dans certaines conditions ; il n'en désigne pas nécessairement la cause. Un résultat non reproduit peut renseigner sur un effet, un protocole ou une variabilité. Son apport dépend notamment de la précision du test et de la comparabilité des conditions.</p>
      <p>La dépendance au contexte est une hypothèse à étudier. Elle ne suffit pas à expliquer après coup un résultat nul : ses prédictions doivent pouvoir être mises à l'épreuve. Les divergences entre études restent visibles dans chaque fiche.</p>
      <p class="small">Repère méthodologique général : <a href="https://www.ncbi.nlm.nih.gov/books/NBK547524/">National Academies, <em>Reproducibility and Replicability in Science</em> (2019), chapitre 5</a>.</p>
    </details>
  </section>

  <section id="edition">
    <h2>Éditions et méthode</h2>
    <details><summary>Derniers ajouts et archives</summary>
      <p><strong>24 octobre 2026, version 10 :</strong> clinique des expériences exceptionnelles : évaluations des accompagnements, recherches sur les consultations et corpus voisins. Une entrée dédiée distingue les résultats cliniques de la recherche sur les phénomènes psi.</p>
      <p><a href={`${base}data/etat-des-preuves-2026-10-24-v10.json`} download>Version actuelle, {data.topics.length} dossiers (JSON)</a> · <a href={`${base}data/etat-des-preuves-2026-10-24-v10.csv`} download>Données des graphiques (CSV)</a></p>
      <p>Version 9, 25 dossiers, 24 octobre : rétro-PK, double fente, détection consciente du regard, FieldREG, psi animal, fin de vie, xénoglossie et conditions d'obtention ; volet psychométrie et archéologie intuitive. <a href={`${base}data/etat-des-preuves-2026-10-24-v9.json`} download>JSON</a> · <a href={`${base}data/etat-des-preuves-2026-10-24-v9.csv`} download>CSV</a>.</p>
      <p>Version 8, 17 dossiers, 24 octobre : expériences hors du corps et neurosciences du psi, à partir du manuel et de publications de 2025–2026. <a href={`${base}data/etat-des-preuves-2026-10-24-v8.json`} download>JSON</a> · <a href={`${base}data/etat-des-preuves-2026-10-24-v8.csv`} download>CSV</a>.</p>
      <p>Version 7, 15 dossiers, 24 octobre : médiumnité complétée par les protocoles avec sitters, Schwartz, Beischel, les recherches brésiliennes et l'étude de la transe. <a href={`${base}data/etat-des-preuves-2026-10-24-v7.json`} download>JSON</a> · <a href={`${base}data/etat-des-preuves-2026-10-24-v7.csv`} download>CSV</a>.</p>
      <p>Version 6, 15 dossiers, 24 octobre : volet GCP 2.0 et clarification de la sélection psi selon Bancel. <a href={`${base}data/etat-des-preuves-2026-10-24-v6.json`} download>JSON</a> · <a href={`${base}data/etat-des-preuves-2026-10-24-v6.csv`} download>CSV</a>.</p>
      <p>Version 5, 15 dossiers, 24 octobre : ajout du GCP historique et des analyses de Bancel ; intitulé « exemple de question ouverte ». <a href={`${base}data/etat-des-preuves-2026-10-24-v5.json`} download>JSON</a> · <a href={`${base}data/etat-des-preuves-2026-10-24-v5.csv`} download>CSV</a>.</p>
      <p>Version 4, 14 dossiers, 24 octobre : ajout des corrélations cérébrales, des EMI et des vies antérieures. <a href={`${base}data/etat-des-preuves-2026-10-24-v4.json`} download>JSON</a> · <a href={`${base}data/etat-des-preuves-2026-10-24-v4.csv`} download>CSV</a>.</p>
    </details>
    <details><summary>Sources, périmètre et limites de cette sélection</summary>
      <p>Le <a href="https://www.dunod.com/sciences-humaines-et-sociales/grand-manuel-parapsychologie-scientifique">Grand manuel de parapsychologie scientifique</a> (Évrard, Berghmans et Rabeyron, dir., Dunod, 2025) sert de point de départ : chapitres 3, 4, 5, 6, 7, 8, 9, 13 et 14. Les fiches renvoient aux études originales et distinguent résultats, réanalyses, commentaires et propositions théoriques.</p>
      <p>Pour la clinique des expériences exceptionnelles, recherches ciblées du 24 octobre 2026 sur « anomalous experiences », « exceptional experiences », « clinical parapsychology », « counselling », « therapy outcomes » et « evaluation », ainsi que sur l'IGPP et le CIRCEE. Le chapitre 9 du manuel et les articles identifiés orientent la recherche. Les évaluations directes sont distinguées des études qualitatives, des bilans d'activité et des corpus voisins sur les perceptions inhabituelles ou le deuil. Les bénéfices cliniques ne sont pas des tests de la nature psi d'une expérience.</p>
      <p>Pour les trois premiers dossiers à lecture spécifique, recherche ciblée le 24 octobre 2026 : « isolated EEG correlations systematic review », « AWARE II veridical near-death experiences » et « claimed past-life memories scoping review », complétée par les références du manuel. Vérification via PubMed, Europe PMC, F1000Research, Frontiers, les archives des revues et les dépôts universitaires. La revue de neuroimagerie parue en 2026 et l'outil documentaire vNDE de 2025 sont inclus.</p>
      <p>Pour les ajouts de la version 9, recherches ciblées du 24 octobre 2026 sur « retro-PK », « double slit », « conscious staring », « FieldREG », « animal psi », « terminal lucidity », « xenoglossy », « hypnosis ESP », « meditation ESP », « sheep-goat », « correlation matrix » et « psychometry ». Les fiches distinguent synthèse quantitative, essai contrôlé, observation de terrain, étude de cas et proposition théorique. Une donnée enregistrée à l'avance ne constitue pas un préenregistrement du protocole ; ce dernier n'est mentionné que lorsqu'il est documenté.</p>
      <p>Pour les EHC et les neurosciences, recherche ciblée du 24 octobre 2026 à partir des chapitres 13 et 14 : « out-of-body experiences », « visual targets », « EEG », « event-related potentials », « fMRI » et « frontal inhibition », complétés par les noms d'Acunzo et de Freedman. Vérification dans PubMed, Frontiers, les textes des auteurs, l'ASPR et les dépôts universitaires. Les références précisent si le résumé, des passages ou le texte intégral ont été consultés.</p>
      <p>Pour le GCP, recherche ciblée le 24 octobre 2026 sur les titres des analyses de Bancel et des réponses de Nelson. Vérification dans PubMed, les textes des auteurs, le Journal of Nonlocality et JAEX. La sélection inclut la synthèse de Nelson de 2024 ; elle distingue texte consulté et référence bibliographique vérifiée.</p>
      <p>Autres recherches ciblées du 24 octobre : choix forcé ESP, DMILS, intention de soin, médiumnité, rêve, vision à distance, pressentiment et macro-PK, avec les termes « meta-analysis », « replication » et « preregistered ». Sources : JSE, JAEX, IJoDR, PubMed, F1000Research/Europe PMC, Frontiers et dépôts des auteurs. Les prépublications et les niveaux de consultation sont précisés dans les fiches.</p>
      <p>Pour les trois fiches initiales : recherche du 21 octobre 2026 via PubMed/Europe PMC, F1000Research, PLOS, Frontiers, JAEX, registre KPU et rapport LMU, sur les méta-analyses et réplications de ganzfeld, précognition et micro-PK. Leur date de vérification bibliographique est conservée.</p>
      <p>Sélection documentée, pas encore une revue systématique exhaustive. Pas de nouvelle méta-analyse ni de double lecture indépendante. « Non identifié » décrit les limites de cette recherche et ne signifie pas qu'un travail n'existe pas. Les archives du manuel ne sont pas diffusées ici.</p>
    </details>
    <details><summary>Préparer la photographie annuelle</summary>
      <p>Cycle proposé : veille pendant l'année, clôture au 31 décembre, double lecture par dossier, version datée et conservation des éditions précédentes. Ce brouillon d'octobre n'est pas le bilan complet de 2026.</p>
      <ol><li>Compléter les références et vérifier les chevauchements de corpus.</li><li>Discuter la lecture de chaque dossier et préciser les questions que les prochains travaux pourraient résoudre.</li><li>Désigner deux lecteurs, déclarer les liens avec les études et conserver les désaccords argumentés.</li></ol>
      <p>Un exemple de publication avec analyses et archives : le <a href="https://mrzdcmps.github.io/labreport/">rapport micro-PK de la LMU</a>, à l'échelle d'un laboratoire.</p>
    </details>
  </section>
  <p class="actions"><a class="action" href="https://github.com/recherche-psi/bulletins-recherche-psi/tree/main/src/data">Données sources sur GitHub</a></p>
</div>
</BaseLayout>

<script>
  const input = document.querySelector<HTMLInputElement>('#topic-search');
  const groups = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-topic-group]'));
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('[data-topic-row]'));
  const count = document.querySelector('#topic-count');
  const normalize = (s: string) => s.normalize('NFD').replace(/\p{M}/gu, '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();
  const index = new Map(rows.map(row => [row, normalize(row.dataset.search ?? '')]));
  let previous = new Map(groups.map(group => [group, group.open]));
  let filtering = false;
  const filter = () => {
    const words = normalize(input?.value ?? '').split(' ').filter(Boolean);
    if (words.length && !filtering) previous = new Map(groups.map(group => [group, group.open]));
    rows.forEach(row => { row.hidden = !words.every(word => index.get(row)?.includes(word)); });
    groups.forEach(group => {
      const n = Array.from(group.querySelectorAll<HTMLTableRowElement>('[data-topic-row]')).filter(row => !row.hidden).length;
      group.hidden = n === 0;
      const label = group.querySelector('[data-group-count]');
      if (label) label.textContent = `${n} ${n===1?'dossier':'dossiers'}`;
      if (words.length) group.open = n > 0;
      else if (filtering) group.open = previous.get(group) ?? false;
    });
    filtering = words.length > 0;
    const n = rows.filter(row => !row.hidden).length;
    if (count) count.textContent = `${n} ${n===1?'dossier':'dossiers'}${filtering?' trouvé'+(n===1?'':'s'):''}`;
    const empty = document.querySelector<HTMLElement>('#no-topics');
    if (empty) empty.hidden = n !== 0;
  };
  if (input) {
    const toolbar = document.querySelector<HTMLElement>('#directory-tools');
    if (toolbar) toolbar.hidden = false;
    input.addEventListener('input', filter);
    document.querySelector('#expand-topics')?.addEventListener('click', () => groups.forEach(g => { if (!g.hidden) g.open = true; }));
    document.querySelector('#collapse-topics')?.addEventListener('click', () => groups.forEach(g => { g.open = false; }));
  }
</script>
