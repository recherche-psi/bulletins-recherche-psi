---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const posts = (await getCollection('vulgarisation', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---
<BaseLayout title="Vulgarisation" description="Des articles courts et simples pour comprendre la recherche psi, les rêves, les intuitions et les méthodes scientifiques.">
  <section class="page-head shell-narrow">
    <p class="eyebrow">Comprendre en quelques minutes</p>
    <h1>La recherche psi en questions simples</h1>
    <p>Une question, une expérience, une idée à retenir. Ces articles courts s'appuient sur les bulletins et renvoient aux études originales pour approfondir.</p>
  </section>
  <section class="shell-narrow post-list" aria-label="Articles de vulgarisation">
    {posts.map(post => (
      <article>
        <p>Article {post.data.order} · {post.data.reading} de lecture</p>
        <h2><a href={`${base}vulgarisation/${post.id}/`}>{post.data.title}</a></h2>
        <p>{post.data.description}</p>
      </article>
    ))}
  </section>
</BaseLayout>
