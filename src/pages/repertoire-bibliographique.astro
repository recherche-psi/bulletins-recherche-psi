---
import BaseLayout from '../layouts/BaseLayout.astro';
import notices from '../data/bibliography.json';
import categories from '../data/bibliography-categories.json';
const base = import.meta.env.BASE_URL;
const groups = [...new Set(categories.map(c => c.groupe_navigation))];
const byCategory = new Map(categories.map(c => [c.id, notices.filter(n => n.questions.includes(c.id))]));
const years = notices.flatMap(n => { const match = n.reference.match(/\((1[6-9]\d{2}|20\d{2})\)/); return match ? [Number(match[1])] : []; });
const period = years.length ? `${Math.min(...years)}–${Math.max(...years)}` : '—';
const covered = categories.filter(c => byCategory.get(c.id)!.length > 0).length;
---
<BaseLayout title="Répertoire Bibliographique" description="Références, résumés et analyses des portées et limites des recherches psi, classés selon les 43 questions de l’état des preuves." alternatePath={null}>
  <div class="bibliography">
    <header class="bib-head shell">
      <p class="eyebrow">Recherche psi · Répertoire bibliographique</p>
      <h1>Les recherches,<br />question par question</h1>
      <p class="bib-intro">Un répertoire pour explorer les méthodes, les résultats et les limites des recherches sur les phénomènes psi et les expériences exceptionnelles. Les références suivent le même découpage que <a href={`${base}etat-des-preuves/`}>l’état des preuves</a>.</p>
      <dl class="bib-kpis" aria-label="Le répertoire en chiffres">
        <div><dt>Références</dt><dd>{notices.length}</dd></div>
        <div><dt>Catégories couvertes</dt><dd>{covered}<span> / {categories.length}</span></dd></div>
        <div><dt>Période bibliographique</dt><dd>{period}</dd></div>
      </dl>
      <p class="bib-note">Répertoire enrichi progressivement. Une référence peut relever de plusieurs questions. La période porte sur les références datées.</p>
      <div class="bib-search">
        <label for="bib-search">Rechercher un auteur, une méthode ou un sujet</label>
        <div class="bib-search-row"><input id="bib-search" type="search" placeholder="Ex. : Ganzfeld, rêves, réplication…" /><button id="bib-reset" type="button">Tout afficher</button></div>
        <p id="bib-count" aria-live="polite" data-total={notices.length}>{notices.length} références · {categories.length} catégories</p>
      </div>
    </header>
    <div class="bib-layout shell">
      <nav id="sommaire" class="bib-toc" aria-label="Sommaire des catégories" tabindex="-1">
        <h2>Sommaire</h2>
        {groups.map(group => <div class="bib-toc-group"><h3>{group}</h3><ul>{categories.filter(c => c.groupe_navigation === group).map(c => <li><a href={`#${c.id}`}><span>{c.titre}</span><span class="bib-number">{byCategory.get(c.id)!.length}</span></a></li>)}</ul></div>)}
      </nav>
      <div class="bib-notices">
        <p id="bib-no-results" hidden>Aucune référence ne correspond à cette recherche.</p>
        {groups.map(group => <div class="bib-group"><h2>{group}</h2>{categories.filter(c => c.groupe_navigation === group).map(c => <section class="bib-category" id={c.id}>
          <div class="bib-category-heading"><h3>{c.titre}</h3><a class="bib-back" href="#sommaire">Sommaire ↑</a></div><p class="bib-question">{c.question}</p>
          {byCategory.get(c.id)!.map(n => <article class="bib-card" id={`${n.id}-${c.id}`} data-id={n.id}>
            <h4>{n.reference}</h4><h5>Résumé</h5><p>{n.resume}</p>
            <div class="bib-analysis"><h5>Portée et limites</h5><p>{n.limites}</p></div>
            <div class="bib-notice-footer">{n.url && <a class="bib-publication" href={n.url}>Consulter la publication <span aria-hidden="true">↗</span></a>}<a class="bib-back" href="#sommaire">↑ Retour au sommaire</a></div>
          </article>)}
        </section>)}</div>)}
      </div>
    </div>
    <a class="bib-floating" href="#sommaire">↑ Sommaire</a>
  </div>
</BaseLayout>
<script>
  const input = document.querySelector<HTMLInputElement>('#bib-search')!;
  const count = document.querySelector<HTMLElement>('#bib-count')!;
  const initialCount = count.textContent!;
  const normalize = (text: string) => text.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
  const sections = [...document.querySelectorAll<HTMLElement>('.bib-category')];
  const groups = [...document.querySelectorAll<HTMLElement>('.bib-group')];
  const indexed = sections.map(section => ({section, cards: [...section.querySelectorAll<HTMLElement>('.bib-card')].map(card => ({card, text: normalize(`${section.querySelector('h3')?.textContent} ${section.querySelector('.bib-question')?.textContent} ${card.textContent}`)}))}));
  function filter() {
    const terms = normalize(input.value).trim().split(/\s+/).filter(Boolean);
    const ids = new Set<string>();
    for (const {section, cards} of indexed) {
      let visible = 0;
      for (const {card, text} of cards) {
        const matches = terms.every(term => text.includes(term));
        card.hidden = !matches;
        if (matches) { ids.add(card.dataset.id!); visible++; }
      }
      section.hidden = terms.length > 0 && visible === 0;
    }
    for (const group of groups) group.hidden = [...group.querySelectorAll<HTMLElement>('.bib-category')].every(s => s.hidden);
    count.textContent = terms.length ? `${ids.size} référence${ids.size > 1 ? 's' : ''} trouvée${ids.size > 1 ? 's' : ''}` : initialCount;
    document.querySelector<HTMLElement>('#bib-no-results')!.hidden = !terms.length || ids.size > 0;
  }
  input.addEventListener('input', filter);
  document.querySelector('#bib-reset')!.addEventListener('click', () => { input.value = ''; filter(); input.focus(); });
  document.querySelectorAll('.bib-toc a').forEach(link => link.addEventListener('click', () => { input.value = ''; filter(); }));
</script>
<style>
.bibliography { padding-bottom:5rem; }
.bib-head { padding-block:3.5rem 2.5rem; }
.bib-head h1 { font-size:clamp(2.4rem,5vw,4.3rem); font-weight:500; margin:1rem 0 1.6rem; }
.bib-intro { max-width:820px; font-size:1.1rem; }
.bib-intro a,.bib-publication { color:var(--teal); }
.bib-kpis { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); max-width:920px; margin:2.5rem auto 1rem; padding:1.7rem 0; border-block:1px solid var(--line); text-align:center; gap:1rem; }
.bib-kpis div { display:flex; flex-direction:column-reverse; gap:.4rem; }
.bib-kpis div+div { border-left:1px solid var(--line); }
.bib-kpis dt { color:var(--muted); font-size:.82rem; }
.bib-kpis dd { font-family:'Source Serif 4',serif; font-size:clamp(1.7rem,3.3vw,2.7rem); line-height:1.2; margin:0; color:var(--teal); font-variant-numeric:tabular-nums; }
.bib-kpis dd span { font-size:.6em; color:var(--muted); }
.bib-note { text-align:center; font-size:.8rem; color:var(--muted); }
.bib-search { max-width:860px; margin-top:2rem; }
.bib-search label { display:block; font-weight:600; font-size:.9rem; margin-bottom:.5rem; }
.bib-search-row { display:flex; gap:.65rem; }
.bib-search input { width:100%; min-width:0; font:inherit; padding:.8rem 1rem; border:1px solid var(--line); border-radius:6px; background:var(--white); color:var(--ink); }
.bib-search button { flex-shrink:0; padding:.7rem 1rem; font:inherit; border:1px solid var(--line); border-radius:6px; background:var(--white); color:var(--ink); cursor:pointer; }
#bib-count { font-size:.85rem; color:var(--muted); }
.bib-layout { display:grid; grid-template-columns:275px minmax(0,1fr); gap:2.5rem; align-items:start; }
.bib-toc { display:block; position:sticky; top:1rem; max-height:calc(100vh - 2rem); overflow:auto; border-top:2px solid var(--ink); padding:1.25rem 1rem 1rem 0; }
.bib-toc h2 { margin:0 0 1.5rem; font-size:1.35rem; }
.bib-toc h3 { font-family:inherit; font-size:.82rem; text-transform:uppercase; letter-spacing:.04em; line-height:1.4; margin:1.6rem 0 .6rem; }
.bib-toc ul { list-style:none; margin:0; padding:0; }
.bib-toc a { display:flex; justify-content:space-between; gap:.75rem; padding:.4rem 0; font-size:.83rem; line-height:1.45; }
.bib-toc a:hover { text-decoration:underline; }
.bib-number { color:var(--muted); font-variant-numeric:tabular-nums; }
.bib-notices { min-width:0; }
.bib-group>h2 { font-size:1.9rem; border-top:2px solid var(--ink); padding-top:1.5rem; margin:0 0 1.5rem; }
.bib-group+.bib-group { margin-top:3.5rem; }
.bib-category { margin-bottom:2.75rem; scroll-margin-top:1.5rem; }
.bib-category-heading { display:flex; justify-content:space-between; align-items:baseline; gap:1rem; }
.bib-category h3 { font-size:1.55rem; line-height:1.3; margin:.7rem 0; }
.bib-back { font-size:.75rem; white-space:nowrap; color:var(--teal); }
.bib-question { font-size:.9rem; color:var(--muted); margin:0 0 1.25rem; }
.bib-card { background:var(--white); border:1px solid var(--line); border-radius:10px; padding:1.7rem; margin:1.25rem 0; overflow-wrap:anywhere; }
.bib-card h4 { font-size:1.07rem; line-height:1.6; margin:0 0 1.5rem; }
.bib-card h5 { font-size:.76rem; text-transform:uppercase; letter-spacing:.07em; margin:1.3rem 0 .5rem; }
.bib-card p { font-size:.95rem; margin:0 0 1rem; }
.bib-analysis { border-left:3px solid #b59b69; padding-left:1rem; margin-top:1.5rem; }
.bib-notice-footer { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:.8rem; }
.bib-publication { font-size:.84rem; font-weight:600; }
.bib-floating { position:fixed; right:1rem; bottom:1rem; border-radius:2rem; padding:.65rem 1rem; background:var(--ink); color:var(--white); font-size:.8rem; z-index:5; box-shadow:0 2px 10px #0002; }
#bib-no-results { padding:2rem; border:1px solid var(--line); }
[hidden] { display:none!important; }
.bibliography :is(a,input,button):focus-visible { outline:3px solid var(--teal); outline-offset:4px; }
@media(max-width:900px) { .bib-layout { grid-template-columns:1fr; gap:2rem; } .bib-toc { position:static; max-height:none; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 1.5rem; padding-right:0; } .bib-toc>h2 { grid-column:1/-1; } }
@media(max-width:520px) { .bib-toc { grid-template-columns:1fr; } .bib-card { padding:1.2rem; } .bib-category-heading { display:block; } .bib-search-row { flex-wrap:wrap; } .bib-kpis { gap:.4rem; } .bib-kpis dt { font-size:.7rem; } .bib-kpis dd { font-size:1.4rem; } }
@media print { .bib-toc,.bib-search,.bib-back,.bib-floating { display:none; } .bib-layout { display:block; } .bib-card { break-inside:avoid; } }
</style>
