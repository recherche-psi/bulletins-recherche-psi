---
interface Props { chart: {title:string;axis:string;min:number;max:number;nullValue:number;ticks:number[];rows:{label:string;value:number;low:number;high:number;display:string}[];note:string}; id:string; lang?: 'fr' | 'en'; }
const {chart, id, lang = 'fr'} = Astro.props;
const x = (v:number) => `${4+(v-chart.min)/(chart.max-chart.min)*92}%`;
---
<figure class="evidence-chart" aria-labelledby={`${id}-chart-title`}>
  <h2 id={`${id}-chart-title`}>{chart.title}</h2>
  <p class="chart-axis">{chart.axis} · {lang === 'en' ? 'point = estimate, line = interval' : 'point = estimation, trait = intervalle'}</p>
  <div class="plot">
    {chart.rows.map(r=><div class="plot-row">
      <div class="row-caption"><span>{r.label}</span><strong>{r.display}</strong></div>
      <svg width="100%" height="36" aria-hidden="true" focusable="false">
        {chart.ticks.map(t=><line x1={x(t)} x2={x(t)} y1="0" y2="36" stroke="#e0ded5"/>)}
        <line x1={x(chart.nullValue)} x2={x(chart.nullValue)} y1="0" y2="36" stroke="#596765" stroke-dasharray="4 3"/>
        <line x1={x(r.low)} x2={x(r.high)} y1="18" y2="18" stroke="#15756f" stroke-width="3"/>
        <line x1={x(r.low)} x2={x(r.low)} y1="11" y2="25" stroke="#15756f" stroke-width="2"/>
        <line x1={x(r.high)} x2={x(r.high)} y1="11" y2="25" stroke="#15756f" stroke-width="2"/>
        <circle cx={x(r.value)} cy="18" r="5" fill="#152c35"/>
      </svg>
    </div>)}
    <div class="plot-ticks" aria-hidden="true">{chart.ticks.map(t=><span style={`left:${x(t)}`}>{t.toLocaleString(lang === 'en' ? 'en-GB' : 'fr-FR')}</span>)}</div>
  </div>
  <figcaption>{chart.note}</figcaption>
</figure>
<style>
figure{margin:2rem 0;padding:1.5rem;background:var(--white);border:1px solid var(--line);border-radius:8px}h2{font-size:1.5rem;margin:0 0 .5rem}.chart-axis{font-size:.8rem;color:var(--muted);margin:0 0 1.2rem}.plot{max-width:800px;margin:auto}.plot-row+.plot-row{margin-top:.7rem}.row-caption{display:flex;justify-content:space-between;gap:1rem;font-size:.85rem}.row-caption strong{font-variant-numeric:tabular-nums;font-weight:500;white-space:nowrap}svg{display:block}.plot-ticks{position:relative;height:1.8rem;font-size:.75rem;color:var(--muted)}.plot-ticks span{position:absolute;transform:translateX(-50%)}figcaption{font-size:.8rem;color:var(--muted);max-width:95ch;margin-top:.6rem}@media(max-width:600px){figure{padding:1rem}.row-caption{font-size:.78rem;gap:.5rem;flex-wrap:wrap}.plot-ticks{font-size:.67rem}}@media print{figure{break-inside:avoid}}
</style>
