---
interface Props { rows: string[][]; lang?: 'fr' | 'en'; }
const { rows, lang = 'fr' } = Astro.props;
const labels = lang === 'en' ? ['Reference / type', 'Scope', 'Finding', 'Implications and limitations'] : ['Référence / type', 'Périmètre', 'Résultat', 'Portée et limite'];
---
<div class="table-scroll"><table class="studies">
  <thead><tr>{labels.map(label=><th scope="col">{label}</th>)}</tr></thead>
  <tbody>{rows.map(r=><tr><th scope="row"><a href={`#${r[5]}`}>{r[0]}</a><small>{r[1]}</small></th><td data-label={labels[1]}>{r[2]}</td><td data-label={labels[2]}>{r[3]}</td><td data-label={labels[3]}>{r[4]}</td></tr>)}</tbody>
</table></div>
